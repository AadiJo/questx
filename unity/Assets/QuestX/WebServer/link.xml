<linker>
  <!-- Preserve WebServer types -->
  <assembly fullname="QuestX">
    <type fullname="QuestX.WebServer.*" preserve="all" />
    <!-- Synchronized preview DTOs are serialized through JSON.NET reflection. -->
    <type fullname="QuestX.QuestX.AprilTag.AprilTagOverlayMetadata" preserve="all" />
    <type fullname="QuestX.QuestX.AprilTag.AprilTagOverlayTag" preserve="all" />
    <type fullname="QuestX.QuestX.AprilTag.AprilTagOverlayPoint" preserve="all" />
  </assembly>
  <!-- Preserve EmbedIO for HTTP server -->
  <assembly fullname="EmbedIO" preserve="all" />
  <assembly fullname="Swan.Lite" preserve="all" />
  <!-- Preserve JSON.NET for serialization -->
  <assembly fullname="Newtonsoft.Json" preserve="all" />
  <!-- Preserve System.ComponentModel for type converters -->
  <assembly fullname="System.ComponentModel.TypeConverter">
    <type fullname="System.ComponentModel.UInt64Converter" preserve="all" />
  </assembly>
</linker>
